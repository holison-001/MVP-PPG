(page_layout
  (setup (textsize 1 1) (linewidth 0.12) (textlinewidth 0.12)
    (left_margin 2) (right_margin 2) (top_margin 2) (bottom_margin 2))
  (rect (name "Frame") (start 0 0 ltcorner) (end 0 0 rbcorner) (linewidth 0.15))
  (line (name "Title separator") (start 0 28 ltcorner) (end 36 28 ltcorner) (linewidth 0.15))
  (tbtext "MVP-PPG / RS-422" (pos 1 30 ltcorner) (font (size 1.2 1.2)) (justify left))
  (tbtext "PCB: 13.5 mm dia. / 4 layers" (pos 1 32.3 ltcorner) (font (size 0.85 0.85)) (justify left))
  (tbtext "Sheet: 40 x 40 mm / Scale 1:1" (pos 1 34.4 ltcorner) (font (size 0.85 0.85)) (justify left))
)
